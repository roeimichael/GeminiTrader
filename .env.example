# ===========================================
# GeminiTrader Environment Configuration
# ===========================================
#
# Copy this file to .env and fill in your values
#
# IMPORTANT: Never commit your .env file to version control!

# ========================================
# Gemini API Keys Configuration
# ========================================
#
# You can configure API keys in THREE different ways:

# OPTION 1: Single API Key (Simplest - Recommended for beginners)
# ---------------------------------------------------------------
# Use this if you have only one Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# OPTION 2: Multiple API Keys - Comma Separated
# ----------------------------------------------
# Use this to cycle through multiple API keys automatically to avoid rate limits
# Separate keys with commas (no spaces)
# GEMINI_API_KEYS=key1_here,key2_here,key3_here

# OPTION 3: Multiple API Keys - Numbered
# ---------------------------------------
# Alternative way to specify multiple keys
# GEMINI_API_KEY_1=first_key_here
# GEMINI_API_KEY_2=second_key_here
# GEMINI_API_KEY_3=third_key_here
# ... add as many as you want

# ========================================
# How Multi-Key Rotation Works
# ========================================
#
# When you provide multiple API keys:
# 1. The system will automatically cycle through them
# 2. If a rate limit is hit on one key, it rotates to the next
# 3. This allows you to process stocks faster without hitting limits
# 4. Rate limit delays are automatically adjusted based on number of keys
#
# Example benefits with 3 keys:
# - 3x faster processing
# - Automatic failover on rate limits
# - Better utilization of free tier quotas

# ========================================
# How to Get Gemini API Keys
# ========================================
#
# 1. Go to https://makersuite.google.com/app/apikey
# 2. Sign in with your Google account
# 3. Click "Create API Key"
# 4. Copy the key and paste it above
# 5. (Optional) Create multiple keys by repeating steps 3-4
